# ==============================================================================
# READNEST DIGITAL LIBRARY - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# ==============================================================================

# 1. MONGODB DATABASE
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas Cloud Cluster or local MongoDB instance).
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/readnest?retryWrites=true&w=majority
# Example Local URI: mongodb://127.0.0.1:27017/readnest
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/readnest?retryWrites=true&w=majority

# 2. BETTER AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used for signing cookies and session tokens.
# Must be at least 32 characters long.
# Generate one via terminal: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_minimum_random_secret_string_here

# Base URL of the application.
# For local development: http://localhost:3000
# For production (Vercel): https://your-production-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. GOOGLE OAUTH CREDENTIALS (Optional for local testing, required for Google Login)
# ------------------------------------------------------------------------------
# Obtain these credentials from the Google Cloud Console:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" of type "Web Application".
# 3. Add Authorized JavaScript Origins:
#    - http://localhost:3000
#    - https://your-production-app.vercel.app
# 4. Add Authorized Redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://your-production-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
